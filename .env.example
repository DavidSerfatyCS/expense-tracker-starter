# Backend (server.js) — set these in Railway
NOTION_API_KEY=
NOTION_DATABASE_ID=
NOTION_INCOME_DATABASE_ID=
# Optional: lock CORS to your Vercel URL in production, e.g. https://your-app.vercel.app
ALLOWED_ORIGIN=

# Frontend (Vite) — set in Vercel. Public URL of the Railway backend, no trailing slash.
# Locally you can leave this unset; it defaults to http://localhost:3002
VITE_API_URL=
